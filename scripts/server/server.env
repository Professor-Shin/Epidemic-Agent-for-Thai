# Server settings for the SLURM runs, preset for CU-AIM (see its "CU-AIM Server User Manual 2026").
# Every script in scripts/server reads this file. Check the values marked CHECK with `check_qos` / `sinfo`.

# ---- paths: clone the repo under your project storage (/data/project/...), not /data/home (small quota)
PROJECT_DIR="$(cd "$_SERVER_DIR/../.." && pwd)"   # this repo (found automatically)
HF_HOME="$PROJECT_DIR/.hf_cache"                  # model weights, ~80 GB for the 5 default models

# ---- software environment
# container (default): Singularity image with Python 3.13 + a venv in the project dir (manual chapter 6). CU-AIM's
#   system libraries are too old for current torch wheels (glibc < 2.28; the same reason new VS Code cannot connect).
# conda / venv: only if `ldd --version` on CU-AIM reports glibc >= 2.28.
ENV_KIND="container"
SINGULARITY_BIN="singularity"
SIF="$PROJECT_DIR/containers/python313.sif"
SIF_SOURCE="docker://python:3.13-slim"
VENV="$PROJECT_DIR/.venv-gabm"                    # container and venv kinds
MODULE_LOAD=""                                    # loaded for every kind, e.g. "module load singularity" if `singularity` is not found
CONDA_MODULE="module load Anaconda3"              # conda kind only (manual 4.4)
CONDA_ENV="gabm"                                  # conda kind only
PYTHON_VERSION="3.13"                             # same as the Colab runs (outputs/runs/*/runtime.json)
TORCH_SPEC="torch==2.11.0"                        # same as the Colab runs
TORCH_INDEX="cu128"                               # CHECK `nvidia-smi` "CUDA Version" in a GPU job: >= 12.8 -> cu128; 13.x -> cu130
PAPERMILL_KERNEL="python3"                        # the environment's own Python kernel

# ---- SLURM, GPU jobs (one per model)
PARTITION="gpu"
QOS="gpu40g"                # CHECK with check_qos. One full A100-40GB, max 16 CPUs / 64 GB / 8 h wall
GPU_GRES="gpu:7g.40gb:1"    # MIG profile of that QoS
CPUS_PER_TASK=8
MEM="64G"
TIME_GPU="08:00:00"         # must be <= the QoS MaxWall (gpu40g: 8 h; gpu40g64: 12 h; gpu10gh: 4 days).
                            # Runs resume from the last finished day, so a timeout only needs a resubmit
MAX_PARALLEL="${MAX_PARALLEL:-2}"   # models holding a GPU at once; CU-AIM is shared by the lab, raise it if the queue is free
# Smaller slices wait less in the queue: GPU_GRES="gpu:3g.20gb:1" with its QoS (check_qos) and SEEDS_IN_PARALLEL=0

# ---- SLURM, analysis job (no GPU)
CPU_PARTITION=""            # empty = the cluster's default partition; CHECK with sinfo if the job is rejected
CPU_QOS="cpu40h"            # CHECK with check_qos
MEM_CPU="32G"
TIME_CPU="02:00:00"

# ---- experiment
MODELS="llama8b typhoon8b qwen7b openthaigpt7b seallm7b"   # 2x2 core panel + SEA control; mistral7b is optional
DAYS=180                    # must match DAYS in notebooks 04/05
# Overridable for a one-off submit without editing this file, e.g.
#   STAGES=order MAX_PARALLEL=5 bash scripts/server/submit_all.sh
STAGES="${STAGES:-feasibility C D}"   # add "order" and/or "sens" for the robustness runs of notebook 04
SEEDS_IN_PARALLEL=1         # 1: the 3 seeds run as 3 processes on one GPU (~30 GB, fits 7g.40gb); 0: in turn
HF_OFFLINE=1                # 1: jobs only read HF_HOME (run download.sh first); 0: jobs may download
